{
  "openapi" : "3.0.1",
  "info" : {
    "title" : "hugmesh-forum-bff-api",
    "description" : "Forum BFF API (/bff/forum/**) — the single browser->phpBB path wrapping the headless phpBB forum per role + action: authenticated read/post under /bff/forum/**, MOD+FORUM moderation under /bff/forum/moderation/**, and the ADMIN console seam under /bff/forum/admin/**. phpBB has no native REST API; the headless hugmesh/forum-api extension client is a gated stub-seam.",
    "version" : "0.1.0"
  },
  "servers" : [ {
    "url" : "http://localhost:42077",
    "description" : "Generated server url"
  } ],
  "tags" : [ {
    "name" : "ForumModeration",
    "description" : "MOD+FORUM (or ADMIN) moderation: hide/delete any post, lock threads, view the moderation queue. AND-of-MOD+FORUM (not hasAnyRole)."
  }, {
    "name" : "ForumAdmin",
    "description" : "ADMIN-only forum console seam (admin-bff calls this): ban/unban, group assign, stats, audit, style/extension install."
  }, {
    "name" : "Forum",
    "description" : "Authenticated forum surface wrapping headless phpBB: categories, topics, replies, and owner-scoped edit/delete. ROLE_FORUM (or ROLE_ADMIN)."
  }, {
    "name" : "ForumVnProfile",
    "description" : "Visual-novel reading-mode profiles: the caller's own sticker/character-image/voicebox presentation (GET/PUT /me, never 404 — defaults are synthesized) and the batched author lookup (1..50 subjects). Authenticated; no forum role required."
  } ],
  "paths" : {
    "/bff/forum/vn-profiles/me" : {
      "get" : {
        "tags" : [ "ForumVnProfile" ],
        "summary" : "Get the caller's VN profile (never 404 — synthesized defaults when none is stored).",
        "operationId" : "getMyVnProfile",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/VnProfile"
                }
              }
            }
          }
        }
      },
      "put" : {
        "tags" : [ "ForumVnProfile" ],
        "summary" : "Create or update the caller's VN profile (subject always from the JWT, never the body).",
        "operationId" : "updateMyVnProfile",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateVnProfile"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/VnProfile"
                }
              }
            }
          }
        }
      }
    },
