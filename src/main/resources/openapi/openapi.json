  "components" : {
    "schemas" : {
      "UpdateVnProfile" : {
        "required" : [ "voiceboxStyle" ],
        "type" : "object",
        "properties" : {
          "stickerSlug" : {
            "pattern" : "^[a-z0-9_-]{1,64}$",
            "type" : "string"
          },
          "characterImgRef" : {
            "maxLength" : 256,
            "minLength" : 0,
            "pattern" : "^/bff/user/(?!.*\\.\\.)[A-Za-z0-9._/-]{1,246}$",
            "type" : "string"
          },
          "voiceboxStyle" : {
            "minLength" : 1,
            "pattern" : "^(classic|glass|retro|neon|paper)$",
            "type" : "string"
          },
          "voiceboxAccent" : {
            "pattern" : "^#[0-9a-f]{6}$",
            "type" : "string"
          },
          "voiceStyle" : {
            "pattern" : "^(warm|bright|deep|soft|robot)$",
            "type" : "string"
          }
        }
      },
      "VnProfile" : {
        "type" : "object",
        "properties" : {
          "subject" : {
            "type" : "string"
          },
          "stickerSlug" : {
            "type" : "string"
          },
          "characterImgRef" : {
            "type" : "string"
          },
          "voiceboxStyle" : {
            "type" : "string"
          },
          "voiceboxAccent" : {
            "type" : "string"
          },
          "voiceStyle" : {
            "type" : "string"
          }
        }
      },
      "EditPost" : {
        "required" : [ "body" ],
        "type" : "object",
        "properties" : {
          "body" : {
            "maxLength" : 64000,
            "minLength" : 0,
            "type" : "string"
          }
        }
      },
      "VnLookupRequest" : {
        "required" : [ "subjects" ],
        "type" : "object",
        "properties" : {
          "subjects" : {
            "maxItems" : 50,
            "minItems" : 1,
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          }
        }
      },
      "VnLookupResponse" : {
        "type" : "object",
        "properties" : {
          "profiles" : {
            "type" : "object",
            "additionalProperties" : {
              "$ref" : "#/components/schemas/VnProfileView"
            }
          }
        }
      },
      "VnProfileView" : {
        "type" : "object",
        "properties" : {
          "stickerSlug" : {
            "type" : "string"
          },
          "characterImgRef" : {
            "type" : "string"
          },
          "voiceboxStyle" : {
            "type" : "string"
          },
          "voiceboxAccent" : {
            "type" : "string"
          },
          "voiceStyle" : {
            "type" : "string"
          }
        }
      },
      "CreateTopic" : {
        "required" : [ "body", "title" ],
        "type" : "object",
        "properties" : {
          "categoryId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "title" : {
            "maxLength" : 255,
            "minLength" : 0,
            "type" : "string"
          },
          "body" : {
            "maxLength" : 64000,
            "minLength" : 0,
            "type" : "string"
          }
        }
      },
      "CreateReply" : {
        "required" : [ "body" ],
        "type" : "object",
        "properties" : {
          "body" : {
            "maxLength" : 64000,
            "minLength" : 0,
            "type" : "string"
          }
        }
      },
      "ModerationAction" : {
        "required" : [ "action" ],
        "type" : "object",
        "properties" : {
          "action" : {
            "minLength" : 1,
            "type" : "string"
          },
          "reason" : {
            "type" : "string"
          }
        }
      },
      "GroupBody" : {
        "required" : [ "group" ],
        "type" : "object",
        "properties" : {
          "group" : {
            "maxLength" : 64,
            "minLength" : 0,
            "type" : "string"
          }
        }
      },
      "BanBody" : {
        "type" : "object",
        "properties" : {
          "reason" : {
            "maxLength" : 1000,
            "minLength" : 0,
            "type" : "string"
          }
        }
      },
      "InstallBody" : {
        "required" : [ "name" ],
        "type" : "object",
        "properties" : {
          "name" : {
            "maxLength" : 255,
            "minLength" : 0,
            "type" : "string"
          }
        }
      },
      "CreateCategory" : {
        "required" : [ "name" ],
        "type" : "object",
        "properties" : {
          "name" : {
            "maxLength" : 255,
            "minLength" : 0,
            "type" : "string"
          },
          "description" : {
            "maxLength" : 4000,
            "minLength" : 0,
            "type" : "string"
          },
          "parentId" : {
            "type" : "integer",
            "format" : "int64"
          }
        }
      },
      "ForumUser" : {
        "type" : "object",
        "properties" : {
          "casdoorSubject" : {
            "type" : "string"
          },
          "phpbbUserId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "group" : {
            "type" : "string"
          }
        }
      },
      "Stats" : {
        "type" : "object",
        "properties" : {
          "topics" : {
            "type" : "integer",
            "format" : "int64"
          },
          "posts" : {
            "type" : "integer",
            "format" : "int64"
          },
          "activeUsers" : {
            "type" : "integer",
            "format" : "int64"
          },
          "moderationQueueDepth" : {
            "type" : "integer",
            "format" : "int64"
          },
          "source" : {
            "type" : "string"
          }
        }
      }
    }
  }
