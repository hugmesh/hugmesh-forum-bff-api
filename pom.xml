<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The org metapom — consolidates the Spring Boot 4.0.7 / Java 25 reactive BFF
       baseline (WebFlux + Casdoor OAuth2 resource server + R2DBC/Liquibase +
       SpringDoc), the shared <dependencies>, dependencyManagement (hugmesh-commons,
       AWS SDK BOM, resilience4j, springdoc), pluginManagement (compiler / surefire
       bytebuddy flag / spring-boot / native) and the GitLab Maven publishing wiring.
       hugmesh-parent is itself a child of spring-boot-starter-parent:4.0.7, so the
       Spring Boot dependency + plugin management (plus the Testcontainers BOM, the
       r2dbc-h2/h2 pins and the spring-boot-liquibase starter) is inherited TRANSITIVELY. -->
  <parent>
    <groupId>net.hugmesh</groupId>
    <artifactId>hugmesh-parent</artifactId>
    <version>2.9.0-beta.1</version>
    <relativePath/>
  </parent>

  <!-- Own coordinate stated EXPLICITLY rather than inherited from <parent>: an
       omitted <groupId> silently tracks whatever the parent publishes under, which
       is exactly how this module kept publishing under the OLD reverse-domain
       coordinate long after its packages had already moved to net.hugmesh. -->
  <groupId>net.hugmesh</groupId>
  <!-- NO -api suffix in the artifactId (mirrors user-bff/admin-bff): -api is only in
       the repo/service/image name. -->
  <artifactId>forum-bff</artifactId>
  <version>0.2.0-beta.1</version>
  <name>hugmesh-forum-bff-api</name>
  <description>HugMesh forum BFF — Casdoor-aware reactive proxy in front of phpBB</description>

  <!-- java.version (25), encoding, the hugmesh-commons / springdoc / resilience4j
       versions are all inherited from hugmesh-parent. This BFF has no repo-specific
       version pins left. -->

  <dependencies>
    <!-- The shared, canonical HugMesh security/tenancy/config/web building blocks
         (Casdoor JWT authorities, issuer->domain DomainRegistry, the Roles/PrincipalDomain
         helpers, the config-gated multi-issuer TenancyResourceServerConfig, the static
         DomainScope predicate utility, the BFF ApiException). Version is MANAGED by
         hugmesh-parent's dependencyManagement, so NO <version> here. This replaces
         forum-bff's deleted local copies of security.{CasdoorAuthorities,DomainRegistry,
         DomainScope} + config.TenancyResourceServerConfig + web.ApiException. The repo
         KEEPS its own security.{Roles,PrincipalDomain} (extra used API — see README). -->
    <dependency>
      <groupId>net.hugmesh</groupId>
      <artifactId>hugmesh-commons</artifactId>
    </dependency>

    <!-- The hugmesh-commons TEST-JAR — supplies the shared full-context test base
         net.hugmesh.commons.testsupport.PostgresTestSupport (a singleton
         Testcontainers Postgres + a fresh per-class logical DB + r2dbc/Liquibase
         DynamicPropertySource wiring). The full-context @SpringBootTest classes extend
         it instead of the old dual-handle in-mem H2 (which stopped sharing its store
         under Boot 4). Version pinned explicitly to 2.2.0-beta.1, the same commons
         coordinate hugmesh-parent 2.9.0-beta.1 manages as hugmesh-commons.version;
         the parent's dependencyManagement does NOT manage the tests classifier, so the
         <version> must stay explicit here. -->
    <dependency>
      <groupId>net.hugmesh</groupId>
      <artifactId>hugmesh-commons</artifactId>
      <version>2.2.0-beta.1</version>
      <classifier>tests</classifier>
      <scope>test</scope>
    </dependency>

    <!-- ============================================================================
         The core reactive BFF stack (webflux / actuator / security /
         oauth2-resource-server / validation), the data-access stack (data-r2dbc /
         r2dbc-postgresql / liquibase-core / spring-jdbc / postgresql), springdoc, and
         the whole test stack (spring-boot-starter-test / reactor-test /
         spring-security-test / r2dbc-h2 / h2) are INHERITED from hugmesh-parent's
         common <dependencies>. They were removed here to de-duplicate. ONLY the
         repo-specific dependencies below remain.
         ============================================================================ -->

    <!-- resilience4j circuit breaker (reactive) — guards the OUTBOUND calls to the
         phpBB hugmesh/forum-api extension (the headless seam) and the
         PhpbbAdminClient ban/suspend seam. A stalled/erroring phpBB trips the
         breaker; the fallback returns a DEGRADED outcome (never a success). Versions
         are MANAGED by hugmesh-parent (2.4.0, the Boot-4 starter line) so no
         <version> here. Repo-specific — stays here. -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-spring-boot4</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-reactor</artifactId>
    </dependency>
  </dependencies>

  <build><plugins>
    <!-- The spring-boot, native and surefire (bytebuddy-experimental argLine)
         plugins are configured in hugmesh-parent's pluginManagement; declaring
         them here (no config) binds the managed config. The native plugin is bound
         so `./mvnw -Pnative native:compile` works; spring-boot repackages the app. -->
    <plugin>
      <groupId>org.graalvm.buildtools</groupId>
      <artifactId>native-maven-plugin</artifactId>
    </plugin>
    <plugin>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-maven-plugin</artifactId>
    </plugin>
    <!-- Binds the parent-managed spotbugs-maven-plugin config (offline, from the
         local repo cache) with a repo-local exclude filter: EI_EXPOSE_REP2 is a
         false positive on every constructor-injection site here (WebClient /
         R2dbcRepository / service beans stored into final fields), and there is
         no parent-level exclude filter to inherit. See spotbugs/exclude-filter.xml. -->
    <plugin>
      <groupId>com.github.spotbugs</groupId>
      <artifactId>spotbugs-maven-plugin</artifactId>
      <configuration>
        <excludeFilterFile>${project.basedir}/spotbugs/exclude-filter.xml</excludeFilterFile>
      </configuration>
    </plugin>
  </plugins></build>

  <profiles>
    <!-- Native build: `./mvnw -Pnative native:compile` produces a GraalVM binary.
         The parent's native plugin management does the heavy lifting; this thin
         local profile mirrors user-bff so the same `-Pnative` invocation works. -->
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
